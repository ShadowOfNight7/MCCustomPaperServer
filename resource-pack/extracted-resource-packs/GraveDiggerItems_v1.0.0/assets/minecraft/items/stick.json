{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:custom_name",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "minecraft:custom_name",
      "cases": [
        {
          "when": "Nation Rally Wall Banner",
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              {
                "when": "gui",
                "model": {
                  "type": "minecraft:model",
                  "model": "grave_digger:item/nation/rallybanner_wall_gui"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "grave_digger:item/nation/rallybanner_wall"
            }
          }
        },
        {
          "when": "Empire Rally Wall Banner",
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              {
                "when": "gui",
                "model": {
                  "type": "minecraft:model",
                  "model": "grave_digger:item/empire/rallybanner_wall_gui"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "grave_digger:item/empire/rallybanner_wall"
            }
          }
        },
        {
          "when": "Empire Rally Banner",
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              {
                "when": "gui",
                "model": {
                  "type": "minecraft:model",
                  "model": "grave_digger:item/empire/rallybanner_gui"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "grave_digger:item/empire/rallybanner"
            }
          }
        },
        {
          "when": "Nation Rally Banner",
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              {
                "when": "gui",
                "model": {
                  "type": "minecraft:model",
                  "model": "grave_digger:item/nation/rallybanner_gui"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:model",
              "model": "grave_digger:item/nation/rallybanner"
            }
          }
        }
      ]
    },
    "on_false": {
      "type": "minecraft:model",
      "model": "minecraft:item/stick"
    }
  }
}